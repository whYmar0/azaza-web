# Образец для сокомандника: cp .env.example .env  (.env — не в git).
# Отладка: 1 — только на своём ноутбуке. На сервере — 0 (или строку убрать).
DJANGO_DEBUG=1
# Ключ сайта. На ноутбуке с DJANGO_DEBUG=1 можно оставить пустым.
# На сервере обязателен — сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
